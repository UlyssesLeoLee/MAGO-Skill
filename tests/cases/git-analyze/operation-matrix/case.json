{
  "id": "git-analyze/operation-matrix",
  "skill": "git-analyze",
  "feature": "Analysis covers each operation's safety",
  "invocations": {
    "claude": "/GitAnalyze agent/auth",
    "hermes": "/git-analyze agent/auth",
    "codex": "$git-analyze agent/auth"
  },
  "test_object": {
    "target": "agent/auth",
    "unique_commits": 2,
    "downstream_dependents": [
      "agent/ui"
    ]
  },
  "expected": [
    "Assesses merge, rebase, cherry-pick, squash/rewrite, and cleanup/delete separately."
  ],
  "checks": [
    {
      "file": "references/commands.md",
      "contains": [
        "Operation safety:",
        "- merge",
        "- rebase",
        "- cherry-pick",
        "- squash/rewrite",
        "- cleanup/delete",
        "Dependencies"
      ]
    }
  ]
}
