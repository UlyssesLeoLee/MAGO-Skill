  {
    "id": "git-integrate/gates",
    "skill": "git-integrate",
    "feature": "Integration stops when review, freshness, dependency, or policy gates fail",
    "invocations": {
      "codex": "$git-integrate agent/auth"
    },
    "test_object": {
      "source": "agent/auth",
      "review": "missing",
      "target_freshness": "stale",
      "expected": "blocked"
    },
    "expected": [
      "No merge, squash, or cherry-pick occurs without required acceptance and current state."
    ],
    "checks": [
      {
        "file": "references/commands.md",
        "contains": [
          "review/acceptance is missing",
          "lane HEAD or integration target changed",
          "selected cherry-picks have unresolved dependencies",
          "repository policy forbids the operation",
          "Never convert this command into force-push"
        ]
      },
      {
        "file": "skills/git-integrate/SKILL.md",
        "contains": [
          "A semantic match or automatic skill selection is not authorization to write.",
          "stop if any gate fails"
        ]
      }
    ]
  },
