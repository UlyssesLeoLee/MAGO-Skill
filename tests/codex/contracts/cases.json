          "Repository Snapshot",
          "integration target",
          "worktrees summary",
          "branches summary",
          "remote freshness",
          "high-risk findings",
          "unknowns"
        ]
      },
      {
        "file": "references/reconnaissance.md",
        "contains": [
          "Quick Scan"
        ]
      }
    ]
  },
