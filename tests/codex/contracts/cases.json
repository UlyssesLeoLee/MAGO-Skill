        "file": "references/commands.md",
        "contains": [
          "Operation safety:",
          "- merge",
          "- rebase",
          "- cherry-pick",
          "- squash/rewrite",
          "- cleanup/delete",
          "Dependencies"
        ]
      }
    ]
