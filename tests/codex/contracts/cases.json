  {
    "id": "git-cleanup/preview-classification",
    "skill": "git-cleanup",
    "feature": "Preview classifies safe and blocked candidates without changes",
    "invocations": {
      "codex": "$git-cleanup"
    },
    "test_object": {
      "candidates": [
        {
          "branch": "agent/done",
          "state": "SAFE_CANDIDATE"
        },
        {
          "branch": "agent/dirty",
          "state": "BLOCKED_DIRTY"
        },
        {
          "branch": "agent/dependent",
          "state": "BLOCKED_DEPENDENCY"
        }
      ]
    },
    "expected": [
      "Shows evidence for each candidate and its block reason.",
      "Leaves all refs and worktrees unchanged in preview mode."
    ],
    "checks": [
      {
        "file": "references/commands.md",
        "contains": [
          "### Preview behavior (default)",
          "SAFE_CANDIDATE",
          "BLOCKED_DIRTY",
          "BLOCKED_UNIQUE_WORK",
          "BLOCKED_ACTIVE_OWNER",
          "BLOCKED_DEPENDENCY",
          "BLOCKED_NOT_INTEGRATED",
          "UNKNOWN"
        ]
      },
      {
        "file": "skills/git-cleanup/SKILL.md",
        "contains": [
          "Preview candidates by default"
        ]
      }
