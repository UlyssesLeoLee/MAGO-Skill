[
  {
    "id": "git-recon/help",
    "skill": "git-recon",
    "feature": "Help returns usage before repository inspection",
    "invocations": {
      "codex": "$git-recon --help"
    },
    "test_object": {
      "repository": "absent",
      "arguments": [
        "--help"
      ]
    },
    "expected": [
      "Shows syntax, argument descriptions, defaults, and examples.",
      "Does not inspect or mutate a repository."
    ],
    "checks": [
      {
        "file": "skills/git-recon/SKILL.md",
        "contains": [
          "- Codex: `$git-recon [--remote] [--help]`",
          "`--help`:",
          "Examples:"
        ]
      },
      {
        "file": "references/commands.md",
        "contains": [
          "All five commands accept `--help`",
          "## 1. GitRecon",
          "/GitRecon --help"
        ]
      }
    ]
  },
  {
    "id": "git-recon/remote-refresh",
    "skill": "git-recon",
    "feature": "Remote refresh remains limited to remote-tracking refs",
    "invocations": {
      "codex": "$git-recon --remote"
    },
    "test_object": {
      "remote_ref_state": "stale",
      "allowed_changes": [
        "remote-tracking refs"
      ],
      "forbidden_changes": [
        "branches",
        "worktrees",
        "commit history"
      ]
    },
    "expected": [
      "Reports refresh failure or unavailable remote.",
      "Does not mutate repository topology."
    ],
    "checks": [
      {
        "file": "references/commands.md",
        "contains": [
          "Refresh remote-tracking refs before classification",
          "It does not change branches, worktrees, or commit history.",
          "Report if refresh fails or is unavailable."
        ]
      }
    ]
  },
  {
    "id": "git-recon/snapshot-output",
    "skill": "git-recon",
    "feature": "Snapshot reports repository state and risk fields",
    "invocations": {
      "codex": "$git-recon"
    },
    "test_object": {
      "repository": {
        "branches": [
          "main",
          "agent/auth"
        ],
        "worktrees": [
          "main",
          "agent/auth"
        ],
        "dirty": [
          "agent/auth"
