{
  "id": "git-recon/snapshot-output",
  "skill": "git-recon",
  "feature": "Snapshot reports repository state and risk fields",
  "invocations": {
    "codex": "$git-recon"
  },
  "test_object": {
    "repository": {
      "branches": [
        "main",
        "agent/auth"
      ],
      "worktrees": [
        "main",
        "agent/auth"
      ],
      "dirty": [
        "agent/auth"
      ],
      "ahead_behind": {
        "agent/auth": [
          2,
          1
        ]
      }
    }
  },
  "expected": [
    "Reports target confidence, worktrees, branches, remote freshness, risks, and unknowns."
  ],
  "checks": [
    {
      "file": "references/commands.md",
      "contains": [
        "Repository Snapshot",
        "integration target",
        "worktrees summary",
        "branches summary",
        "remote freshness",
        "high-risk findings",
        "unknowns"
      ]
    },
    {
      "file": "references/reconnaissance.md",
      "contains": [
        "Quick Scan"
      ]
    }
  ]
}
