{
  "id": "git-integrate/help",
  "skill": "git-integrate",
  "feature": "Help lists strategy choices and never performs integration",
  "invocations": {
    "codex": "$git-integrate --help"
  },
  "test_object": {
    "repository": "absent",
    "arguments": [
      "--help"
    ]
  },
  "expected": [
    "Lists required source target, allowed strategies, default, and safety gates without repository inspection."
  ],
  "checks": [
    {
      "file": "skills/git-integrate/SKILL.md",
      "contains": [
        "- Codex: `$git-integrate <lane|branch> [--strategy auto|merge|squash|cherry-pick] [--lang <language>] [--help]`",
        "`--help`:",
        "Examples:"
      ]
    },
    {
      "file": "references/commands.md",
      "contains": [
        "--strategy <value>",
        "Defaults to `auto`.",
        "/GitIntegrate --help"
      ]
    }
  ]
}
