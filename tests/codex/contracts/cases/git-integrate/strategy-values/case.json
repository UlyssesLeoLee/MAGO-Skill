{
  "id": "git-integrate/strategy-values",
  "skill": "git-integrate",
  "feature": "Only supported strategies are accepted and auto is the default",
  "invocations": {
    "codex": "$git-integrate agent/auth --strategy squash"
  },
  "test_object": {
    "source": "agent/auth",
    "strategy_cases": [
      "auto",
      "merge",
      "squash",
      "cherry-pick",
      "unsupported"
    ],
    "default": "auto"
  },
  "expected": [
    "Accepts the four documented values.",
    "Missing or unsupported values stop before integration and show usage."
  ],
  "checks": [
    {
      "file": "skills/git-integrate/SKILL.md",
      "contains": [
        "[--strategy auto|merge|squash|cherry-pick]",
        "Default: Strategy `auto`",
        "missing or invalid"
      ]
    },
    {
      "file": "references/commands.md",
      "contains": [
        "`auto`, `merge`, `squash`, or `cherry-pick`",
        "Defaults to `auto`."
      ]
    }
  ]
}
