{
  "id": "git-recommend/goal-readonly",
  "skill": "git-recommend",
  "feature": "Optional goal scopes advice and never mutates repository state",
  "invocations": {
    "codex": "$git-recommend 哪些分支可以先集成"
  },
  "test_object": {
    "goal": "哪些分支可以先集成",
    "repo_state": {
      "branches": [
        "main",
        "agent/core",
        "agent/ui"
      ],
      "dependencies": [
        [
          "agent/ui",
          "agent/core"
        ]
      ]
    }
  },
  "expected": [
    "Uses fresh repository evidence to rank next actions.",
    "Does not mutate branches, worktrees, or history."
  ],
  "checks": [
    {
      "file": "references/commands.md",
      "contains": [
        "Rank recommendations by risk and dependency",
        "Do not mutate repository state.",
        "Recommended next actions (ordered)"
      ]
    }
  ]
}
