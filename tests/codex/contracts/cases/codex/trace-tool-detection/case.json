{
  "id": "codex/trace-tool-detection",
  "skill": "codex-test-harness",
  "feature": "Help tests distinguish safe skill discovery from Git commands and classify host setup errors",
  "invocations": {
    "codex": "codex exec --json --ephemeral"
  },
  "test_object": {
    "jsonl_item_types": [
      "command_execution",
      "file_change",
      "mcp_tool_call",
      "collab_tool_call",
      "web_search"
    ],
    "host_runtime_error_markers": [
      "helper_unknown_error",
      "setup refresh had errors"
    ],
    "ignored_host_metadata": [
      ".serena"
    ]
  },
  "expected": [
    "The harness records current tool/action item types and distinguishes read-only skill discovery from Git commands.",
    "The harness ignores generated .serena metadata when checking fixture state and classifies helper setup errors as UNVERIFIED."
  ],
  "checks": [
    {
      "file": "tests/codex/run_host_cases.py",
      "contains": [
        "\"command_execution\"",
        "\"file_change\"",
        "\"mcp_tool_call\"",
        "\"collab_tool_call\"",
        "\"web_search\"",
        "if item.get(\"type\") in tool_item_types:",
        "relative_parts",
        "\".serena\" not in relative_parts",
        "no Git command",
        "def has_git_command(tool_calls: list[str]) -> bool:",
        "command = item.get(\"command\") if isinstance(item, dict) else None",
        "not has_git_command(tool_calls)",
        "helper_unknown_error",
        "setup refresh had errors"
      ]
    }
  ]
}
