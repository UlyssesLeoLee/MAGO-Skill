  {
    "id": "git-recon/help",
    "skill": "git-recon",
    "feature": "Help returns usage before repository inspection",
    "invocations": {"claude": "/GitRecon --help", "hermes": "/git-recon --help", "codex": "$git-recon --help"},
    "test_object": {"repository": "absent", "arguments": ["--help"]},
    "expected": ["Shows syntax, argument descriptions, defaults, and examples.", "Does not inspect or mutate a repository."],
    "checks": [
      {"file": "commands/GitRecon.md", "contains": ["argument-hint: \"[--remote] [--help]\"", "If `--help` is present", "stop without loading the orchestrator skill or inspecting the repository"]},
      {"file": "references/commands.md", "contains": ["All five commands accept `--help`", "## 1. GitRecon", "/GitRecon --help"]}
    ]
  },
  {
    "id": "git-recon/remote-refresh",
    "skill": "git-recon",
    "feature": "Remote refresh remains limited to remote-tracking refs",
    "invocations": {"claude": "/GitRecon --remote", "hermes": "/git-recon --remote", "codex": "$git-recon --remote"},
    "test_object": {"remote_ref_state": "stale", "allowed_changes": ["remote-tracking refs"], "forbidden_changes": ["branches", "worktrees", "commit history"]},
    "expected": ["Reports refresh failure or unavailable remote.", "Does not mutate repository topology."],
    "checks": [
      {"file": "commands/GitRecon.md", "contains": ["`--remote` only permits refreshing remote-tracking refs", "never mutate branches, worktrees, or history"]},
      {"file": "references/commands.md", "contains": ["Refresh remote-tracking refs before classification", "It does not change branches, worktrees, or commit history.", "Report if refresh fails or is unavailable."]}
    ]
  },
  {
